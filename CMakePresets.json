{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20
  },

  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",

      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",

      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },

    {
      "name": "release",
      "displayName": "Release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",

      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",

      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "iap",
      "displayName": "IAP (boot + dual-app)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/iap",

      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi-gcc.cmake",

      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_IAP": "ON"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 16
    },

    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 16
    },

    {
      "name": "iap",
      "configurePreset": "iap",
      "jobs": 16
    }
  ]
}
