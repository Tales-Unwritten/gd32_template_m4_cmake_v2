[
  {
    "label": "Configure Debug",
    "command": "cmake --preset debug",
    "cwd": "$ZED_WORKTREE_ROOT",
  },

  {
    "label": "Build Debug",
    "command": "cmake --build --preset debug",
    "cwd": "$ZED_WORKTREE_ROOT",
  },

  {
    "label": "Flash DAPLink",
    "command": "cmake --build --preset debug && cmake --build build/debug --target flash-daplink",
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": "system",
  },

  {
    "label": "Flash JLink",
    "command": "cmake --build --preset debug && cmake --build build/debug --target flash-jlink",
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": "system",
  },

  {
    "label": "OpenOCD DAPLink",
    "command": "cmake --build build/debug --target debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
  },

  {
    "label": "OpenOCD JLink",
    "command": "cmake --build build/debug --target debug-jlink",
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
  },
]

