{
  "version": "0.2.0",

  "configurations": [
    {
      "name": "DAPLink Debug",

      "type": "cortex-debug",

      "request": "launch",

      "cwd": "${workspaceFolder}",

      "executable": "${workspaceFolder}/build/debug/gd32f470_template.elf",

      "servertype": "openocd",

      "configFiles": [
