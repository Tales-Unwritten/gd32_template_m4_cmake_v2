{
  "version": "2.0.0",

  "tasks": [
    {
      "label": "Configure Debug",
      "type": "shell",
      "command": "cmake --preset debug",
      "problemMatcher": [],
    },

    {
      "label": "Build Debug",
      "type": "shell",
      "command": "cmake --build --preset debug",
      "dependsOn": "Configure Debug",
      "group": {
        "kind": "build",
        "isDefault": true,
      },
      "problemMatcher": ["$gcc"],
    },

    {
      "label": "Clean",
      "type": "shell",
      "command": "rm -rf build",
    },

    {
      "label": "Flash DAPLink",
      "type": "shell",
      "command": "cmake --build build/debug --target flash-daplink",
      "dependsOn": "Build Debug",
    },

    {
      "label": "Flash JLink",
      "type": "shell",
      "command": "cmake --build build/debug --target flash-jlink",
      "dependsOn": "Build Debug",
    },

    {
      "label": "OpenOCD DAPLink",
      "type": "shell",
      "command": "cmake --build build/debug --target debug",
      "isBackground": true,
    },

    {
      "label": "OpenOCD JLink",
      "type": "shell",
      "command": "cmake --build build/debug --target debug-jlink",
      "isBackground": true,
    },
  ],
}
