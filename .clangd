CompileFlags:
  CompilationDatabase: build/debug
  Add:
    - --target=arm-none-eabi
    - "-isystem"
    - "/usr/lib/arm-none-eabi/include/c++/14.2.1"
    - "-isystem"
    - "/usr/lib/arm-none-eabi/include/c++/14.2.1/arm-none-eabi"
    - "-isystem"
    - "/usr/lib/arm-none-eabi/include/c++/14.2.1/backward"
    - "-isystem"
    - "/usr/lib/gcc/arm-none-eabi/14.2.1/include"
    - "-isystem"
    - "/usr/lib/gcc/arm-none-eabi/14.2.1/include-fixed"
    - "-isystem"
    - "/usr/lib/arm-none-eabi/include"

Diagnostics:
  UnusedIncludes: None
